<UserControl x:Class="FolderGate.App.Controls.RevealablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core">
    <Grid>
        <PasswordBox x:Name="HiddenInput"
                     MinHeight="34"
                     Padding="10,6,40,6"
                     VerticalContentAlignment="Center"
                     PasswordChanged="HiddenInput_PasswordChanged" />
        <TextBox x:Name="VisibleInput"
                 MinHeight="34"
                 Padding="10,6,40,6"
                 VerticalContentAlignment="Center"
                 Visibility="Collapsed"
                 TextChanged="VisibleInput_TextChanged" />

        <ToggleButton x:Name="RevealToggle"
                      Style="{DynamicResource RevealToggleButton}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,5,0"
                      ToolTip="{x:Static text:AppText.ShowPasswordToggle}"
                      AutomationProperties.Name="{x:Static text:AppText.ShowPasswordToggle}"
                      Checked="RevealToggle_Changed"
                      Unchecked="RevealToggle_Changed" />
    </Grid>
</UserControl>
