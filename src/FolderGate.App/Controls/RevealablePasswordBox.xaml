<UserControl x:Class="FolderGate.App.Controls.RevealablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <PasswordBox x:Name="HiddenInput"
                     MinHeight="34"
                     VerticalContentAlignment="Center"
                     PasswordChanged="HiddenInput_PasswordChanged" />
        <TextBox x:Name="VisibleInput"
                 MinHeight="34"
                 VerticalContentAlignment="Center"
                 Visibility="Collapsed"
                 TextChanged="VisibleInput_TextChanged" />

        <CheckBox x:Name="RevealToggle"
                  Grid.Column="1"
                  Content="{x:Static text:AppText.ShowPasswordToggle}"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0"
                  Checked="RevealToggle_Changed"
                  Unchecked="RevealToggle_Changed" />
    </Grid>
</UserControl>
