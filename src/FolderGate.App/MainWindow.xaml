<controls:ThemedWindow x:Class="FolderGate.App.MainWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
                       xmlns:models="clr-namespace:FolderGate.Core.Models;assembly=FolderGate.Core"
                       xmlns:controls="clr-namespace:FolderGate.App.Controls"
                       xmlns:vm="clr-namespace:FolderGate.App.ViewModels"
                       mc:Ignorable="d"
                       Title="{x:Static text:AppText.ProductName}"
                       Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
                       Width="1060"
                       Height="700"
                       MinWidth="860"
                       MinHeight="560"
                       AllowDrop="True"
                       DragEnter="Window_DragEnter"
                       DragOver="Window_DragOver"
                       DragLeave="Window_DragLeave"
                       Drop="Window_Drop">
    <Window.Resources>
        <!-- State colors for the round state icon of list items and the details header. -->
        <Style x:Key="StateIconCircle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralBadgeForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:FolderLockState.Locked}">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:FolderLockState.TemporarilyUnlocked}">
                    <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:FolderLockState.Working}">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:FolderLockState.RecoveryRequired}">
                    <Setter Property="Background" Value="{DynamicResource CriticalBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CriticalBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedStateIconCircle" TargetType="Border" BasedOn="{StaticResource StateIconCircle}">
            <Setter Property="CornerRadius" Value="24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedStateValue}" Value="{x:Static models:FolderLockState.Locked}">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStateValue}" Value="{x:Static models:FolderLockState.TemporarilyUnlocked}">
                    <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStateValue}" Value="{x:Static models:FolderLockState.Working}">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStateValue}" Value="{x:Static models:FolderLockState.RecoveryRequired}">
                    <Setter Property="Background" Value="{DynamicResource CriticalBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedIsMissing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CriticalBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="FolderItemTemplate" DataType="{x:Type vm:FolderItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource StateIconCircle}">
                    <TextBlock Text="{Binding StateGlyph}"
                               FontFamily="{x:Static controls:ThemeFonts.Icons}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ListStateText}"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding Path}"
                               ToolTip="{Binding Path}"
                               FontSize="12"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,8,0,2"
                             Height="3"
                             Maximum="100"
                             Value="{Binding OperationProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsOperationIndeterminate, Mode=OneWay}"
                             Visibility="{Binding IsOperationRunning, Converter={x:Static controls:Converters.BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Folder list pane ===================== -->
        <Border Background="{DynamicResource PaneBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static text:AppText.ProductName}"
                               Style="{DynamicResource SubtitleText}"
                               FontSize="18"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Style="{DynamicResource IconButton}"
                            Content="&#xE713;"
                            ToolTip="{x:Static text:AppText.SettingsTitle}"
                            AutomationProperties.Name="{x:Static text:AppText.SettingsTitle}"
                            Click="OpenSettings_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                <Button Style="{DynamicResource AccentButton}"
                        HorizontalAlignment="Stretch"
                        MinHeight="36"
                        AutomationProperties.Name="{x:Static text:AppText.AddFolder}"
                        Command="{Binding AddFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="{x:Static controls:ThemeFonts.Icons}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static text:AppText.AddFolder}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        MinHeight="36"
                        Margin="8,0,0,0"
                        ToolTip="{x:Static text:AppText.LockAll}"
                        AutomationProperties.Name="{x:Static text:AppText.LockAll}"
                        Command="{Binding LockAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{x:Static controls:ThemeFonts.Icons}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static text:AppText.LockAll}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                </Grid>

                <TextBox x:Name="SearchBox"
                         Grid.Row="2"
                         Style="{DynamicResource SearchBox}"
                         Tag="{x:Static text:AppText.SearchPlaceholder}"
                         AutomationProperties.Name="{x:Static text:AppText.SearchPlaceholder}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <WrapPanel Grid.Row="3" Margin="0,0,0,6">
                    <RadioButton Style="{DynamicResource ChipRadio}"
                                 GroupName="FolderFilter"
                                 IsChecked="{Binding IsFilterAll}">
                        <TextBlock>
                            <Run Text="{x:Static text:AppText.FilterAll}" />
                            <Run Text="{Binding TotalCount, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton Style="{DynamicResource ChipRadio}"
                                 GroupName="FolderFilter"
                                 IsChecked="{Binding IsFilterLocked}">
                        <TextBlock>
                            <Run Text="{x:Static text:AppText.FilterLocked}" />
                            <Run Text="{Binding LockedCount, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton Style="{DynamicResource ChipRadio}"
                                 GroupName="FolderFilter"
                                 IsChecked="{Binding IsFilterUnlocked}">
                        <TextBlock>
                            <Run Text="{x:Static text:AppText.FilterUnlocked}" />
                            <Run Text="{Binding UnlockedCount, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton Style="{DynamicResource ChipRadio}"
                                 GroupName="FolderFilter"
                                 IsChecked="{Binding IsFilterAttention}"
                                 Visibility="{Binding HasAttention, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <TextBlock>
                            <Run Text="{x:Static text:AppText.FilterAttention}" />
                            <Run Text="{Binding AttentionCount, Mode=OneWay}" />
                        </TextBlock>
                    </RadioButton>
                </WrapPanel>

                <Grid Grid.Row="4">
                    <ListBox x:Name="FolderList"
                             Style="{DynamicResource NavList}"
                             ItemsSource="{Binding FoldersView}"
                             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             ItemTemplate="{StaticResource FolderItemTemplate}"
                             AutomationProperties.Name="{x:Static text:AppText.FoldersHeader}"
                             ContextMenuOpening="FolderList_ContextMenuOpening">
                        <!-- Right-click on a folder: the commands act on the selected
                             folder, and the right click selects it first. Actions that
                             do not apply to the folder's state are hidden. -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static text:AppText.Unlock}"
                                          Command="{Binding UnlockCommand}"
                                          Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE785;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static text:AppText.Lock}"
                                          Command="{Binding LockCommand}"
                                          Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE72E;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static text:AppText.RelockNow}"
                                          Command="{Binding RelockNowCommand}"
                                          Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE72E;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static text:AppText.OpenInExplorer}"
                                          Command="{Binding OpenInExplorerCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE838;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Margin="4" />
                                <MenuItem Header="{x:Static text:AppText.RemoveFolder}"
                                          Command="{Binding RemoveFolderCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74D;" Foreground="{DynamicResource CriticalForegroundBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Text="{x:Static text:AppText.NoSearchResults}"
                               Style="{DynamicResource CaptionText}"
                               Margin="8,16,8,0"
                               TextAlignment="Center"
                               Visibility="{Binding HasNoMatches, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                </Grid>

                <TextBlock Grid.Row="5"
                           Style="{DynamicResource CaptionText}"
                           Margin="6,10,0,0">
                    <Run Text="{Binding FolderCountText, Mode=OneWay}" /><Run Text="  ·  " /><Run x:Name="VersionRun" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- ===================== Details pane ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Empty state: no folders registered yet. -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="420"
                        Visibility="{Binding HasFolders, Converter={x:Static controls:Converters.InverseBoolToVisibility}}">
                <Border Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="{DynamicResource AccentSubtleBrush}"
                        Margin="0,0,0,20">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="{x:Static controls:ThemeFonts.Icons}"
                               FontSize="30"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{x:Static text:AppText.EmptyTitle}"
                           Style="{DynamicResource SubtitleText}"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="{x:Static text:AppText.EmptyBody}"
                           Style="{DynamicResource SecondaryText}"
                           TextAlignment="Center"
                           Margin="0,0,0,20" />
                <Button Style="{DynamicResource AccentButton}"
                        HorizontalAlignment="Center"
                        MinWidth="140"
                        Content="{x:Static text:AppText.AddFolder}"
                        Command="{Binding AddFolderCommand}" />
                <TextBlock Text="{x:Static text:AppText.NotEncryptionNote}"
                           Style="{DynamicResource CaptionText}"
                           TextAlignment="Center"
                           Margin="0,28,0,0" />
            </StackPanel>

            <!-- Details of the selected folder. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={x:Static controls:Converters.BoolToVisibility}}">
                <StackPanel Margin="32,26,32,16" MaxWidth="760" HorizontalAlignment="Stretch">

                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48"
                                Height="48"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SelectedStateIconCircle}">
                            <TextBlock Text="{Binding SelectedStateGlyph}"
                                       FontFamily="{x:Static controls:ThemeFonts.Icons}"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedTitle}" Style="{DynamicResource TitleText}" />
                            <TextBlock Text="{Binding SelectedPath}"
                                       ToolTip="{Binding SelectedPath}"
                                       Style="{DynamicResource SecondaryText}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="MoreButton"
                                Grid.Column="2"
                                Style="{DynamicResource IconButton}"
                                Content="&#xE712;"
                                VerticalAlignment="Center"
                                ToolTip="{x:Static text:AppText.MoreActions}"
                                AutomationProperties.Name="{x:Static text:AppText.MoreActions}"
                                Click="MoreButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static text:AppText.OpenInExplorer}"
                                              Command="{Binding OpenInExplorerCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE838;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding SelectedFolderPasswordMenuText}"
                                              Command="{Binding SetFolderPasswordCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8D7;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static text:AppText.FolderPasswordClearMenu}"
                                              Command="{Binding ClearFolderPasswordCommand}"
                                              Visibility="{Binding SelectedHasOwnPassword, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE72C;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Margin="4" />
                                    <MenuItem Header="{x:Static text:AppText.RemoveFolder}"
                                              Command="{Binding RemoveFolderCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;" Foreground="{DynamicResource CriticalForegroundBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- Missing folder or offline drive -->
                    <Border Style="{DynamicResource InfoBarCritical}"
                            Margin="0,0,0,12"
                            Visibility="{Binding SelectedIsMissing, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="{x:Static controls:ThemeFonts.Icons}"
                                       Foreground="{DynamicResource CriticalForegroundBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,2,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedPresenceTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedPresenceBody}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status and main actions -->
                    <Border Style="{DynamicResource Card}" Padding="20,18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedStatusTitle}"
                                       Style="{DynamicResource BodyStrongText}"
                                       FontSize="16" />
                            <TextBlock Text="{Binding SelectedStatusBody}"
                                       Style="{DynamicResource SecondaryText}"
                                       Margin="0,4,0,16" />
                            <WrapPanel>
                                <Button Style="{DynamicResource AccentButton}"
                                        MinWidth="120"
                                        Margin="0,0,8,0"
                                        Command="{Binding UnlockCommand}"
                                        AutomationProperties.Name="{x:Static text:AppText.Unlock}"
                                        Visibility="{Binding IsUnlockPrimary, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE785;" FontFamily="{x:Static controls:ThemeFonts.Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static text:AppText.Unlock}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource AccentButton}"
                                        MinWidth="120"
                                        Margin="0,0,8,0"
                                        Command="{Binding LockCommand}"
                                        AutomationProperties.Name="{x:Static text:AppText.Lock}"
                                        Visibility="{Binding IsLockPrimary, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="{x:Static controls:ThemeFonts.Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static text:AppText.Lock}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource AccentButton}"
                                        MinWidth="120"
                                        Margin="0,0,8,0"
                                        Command="{Binding RelockNowCommand}"
                                        AutomationProperties.Name="{x:Static text:AppText.RelockNow}"
                                        Visibility="{Binding IsRelockPrimary, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="{x:Static controls:ThemeFonts.Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static text:AppText.RelockNow}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExtendButton"
                                        Margin="0,0,8,0"
                                        Click="ExtendButton_Click"
                                        AutomationProperties.Name="{x:Static text:AppText.ExtendUnlock}"
                                        Visibility="{Binding IsRelockPrimary, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE823;" FontFamily="{x:Static controls:ThemeFonts.Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static text:AppText.ExtendUnlock}" />
                                        <TextBlock Text="&#xE70D;" FontFamily="{x:Static controls:ThemeFonts.Icons}" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="+10" Command="{Binding ExtendUnlockCommand}" CommandParameter="10" />
                                            <MenuItem Header="+30" Command="{Binding ExtendUnlockCommand}" CommandParameter="30" />
                                            <MenuItem Header="+60" Command="{Binding ExtendUnlockCommand}" CommandParameter="60" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{DynamicResource AccentButton}"
                                        MinWidth="120"
                                        Margin="0,0,8,0"
                                        Command="{Binding OpenRecoveryToolCommand}"
                                        AutomationProperties.Name="{x:Static text:AppText.OpenRecoveryTool}"
                                        Visibility="{Binding IsRecoveryPrimary, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE90F;" FontFamily="{x:Static controls:ThemeFonts.Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static text:AppText.OpenRecoveryTool}" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0"
                                        Content="{x:Static text:AppText.Unlock}"
                                        Command="{Binding UnlockCommand}"
                                        Visibility="{Binding ShowUnlockSecondary, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                                <Button Style="{DynamicResource SubtleButton}"
                                        Command="{Binding OpenInExplorerCommand}"
                                        AutomationProperties.Name="{x:Static text:AppText.OpenInExplorer}"
                                        Visibility="{Binding CanOpenInExplorer, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{x:Static controls:ThemeFonts.Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static text:AppText.OpenInExplorer}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Progress of the running operation -->
                    <Border Style="{DynamicResource Card}"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsSelectedBusy, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource BodyStrongText}">
                                    <Run Text="{x:Static text:AppText.ProgressStatus}" /><Run Text="  ·  " /><Run Text="{Binding OperationPhase, Mode=OneWay}" />
                                </TextBlock>
                                <Button Grid.Column="1"
                                        MinHeight="28"
                                        Padding="12,2"
                                        Content="{x:Static text:AppText.Cancel}"
                                        Command="{Binding CancelOperationCommand}" />
                            </Grid>
                            <ProgressBar Maximum="100"
                                         Value="{Binding OperationProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                         Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Static text:AppText.Items}" Style="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Column="1">
                                    <Run Text="{Binding OperationCompleted, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding OperationTotal, Mode=OneWay}" /><Run Text="{x:Static text:AppText.FailedInline}" /><Run Text="{Binding OperationFailed, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" Text="{x:Static text:AppText.Time}" Style="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                                    <Run Text="{x:Static text:AppText.ElapsedInline}" /><Run Text="{Binding OperationElapsed, Mode=OneWay}" /><Run Text="{x:Static text:AppText.EtaInline}" /><Run Text="{Binding OperationEta, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="{x:Static text:AppText.CurrentPath}" Style="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,6,0,0"
                                           Text="{Binding OperationCurrentPath}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding OperationCurrentPath}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Lock mode (only while unlocked) -->
                    <StackPanel Margin="0,8,0,12"
                                Visibility="{Binding ShowModeChoice, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <TextBlock Text="{x:Static text:AppText.LockMode}" Style="{DynamicResource SectionHeaderText}" Margin="2,0,0,2" />
                        <TextBlock Text="{x:Static text:AppText.LockModeHint}" Style="{DynamicResource CaptionText}" Margin="2,0,0,8" />
                        <UniformGrid Columns="2">
                            <RadioButton Style="{DynamicResource OptionCardRadio}"
                                         GroupName="LockMode"
                                         Margin="0,0,6,0"
                                         IsChecked="{Binding IsQuickMode}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static text:AppText.QuickMode}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Static text:AppText.QuickModeDescription}"
                                               Style="{DynamicResource CaptionText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource OptionCardRadio}"
                                         GroupName="LockMode"
                                         Margin="6,0,0,0"
                                         IsChecked="{Binding IsHardenedMode}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static text:AppText.HardenedMode}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Static text:AppText.HardenedModeDescription}"
                                               Style="{DynamicResource CaptionText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Details -->
                    <TextBlock Text="{x:Static text:AppText.DetailsHeader}" Style="{DynamicResource SectionHeaderText}" Margin="2,8,0,8" />
                    <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:AppText.CurrentState}" Style="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedState}" />
                            </Grid>
                            <Separator Margin="0" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:AppText.LockMode}" Style="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedModeText}" />
                            </Grid>
                            <Separator Margin="0" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:AppText.FieldPassword}" Style="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPasswordKind}" />
                            </Grid>
                            <Separator Margin="0" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:AppText.FieldPath}" Style="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPath}" TextWrapping="Wrap" />
                            </Grid>
                            <Separator Margin="0" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:AppText.ColumnLastOperation}" Style="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedLastOperationShort}" />
                            </Grid>
                            <Separator Margin="0" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:AppText.LastResult}" Style="{DynamicResource SecondaryText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedLastResult}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource InfoBarCaution}"
                            Margin="0,0,0,12"
                            Visibility="{Binding SelectedHasWarning, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="{x:Static controls:ThemeFonts.Icons}"
                                       Foreground="{DynamicResource CautionForegroundBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,2,10,0" />
                            <TextBlock Text="{Binding SelectedWarningText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Recent activity of this folder -->
                    <TextBlock Text="{x:Static text:AppText.HistoryHeader}" Style="{DynamicResource SectionHeaderText}" Margin="2,8,0,8" />
                    <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="{x:Static text:AppText.HistoryEmpty}"
                                       Style="{DynamicResource SecondaryText}"
                                       Margin="16,12"
                                       Visibility="{Binding HasSelectedHistory, Converter={x:Static controls:Converters.InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding SelectedHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource DividerStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{DynamicResource SecondaryText}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="OperationText" Text="{Binding Operation}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Message}" Style="{DynamicResource CaptionText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                <Setter TargetName="OperationText" Property="Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Static text:AppText.NotEncryptionNote}"
                               Style="{DynamicResource CaptionText}"
                               Margin="2,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Status line -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource DividerStrokeBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="32,8">
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{DynamicResource CaptionText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />
            </Border>
        </Grid>

        <!-- ===================== Drag and drop overlay ===================== -->
        <Grid x:Name="DropOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Background="{DynamicResource DropOverlayBrush}">
            <Rectangle Margin="16"
                       RadiusX="8"
                       RadiusY="8"
                       Stroke="{DynamicResource AccentBrush}"
                       StrokeThickness="2"
                       StrokeDashArray="6 4" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE898;"
                           FontFamily="{x:Static controls:ThemeFonts.Icons}"
                           FontSize="40"
                           Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14" />
                <TextBlock Text="{x:Static text:AppText.DropOverlayTitle}"
                           Style="{DynamicResource SubtitleText}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static text:AppText.DropOverlayBody}"
                           Style="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</controls:ThemedWindow>
