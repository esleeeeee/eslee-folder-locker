<Window x:Class="FolderGate.App.MasterPasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
        xmlns:controls="clr-namespace:FolderGate.App.Controls"
        Title="{x:Static text:AppText.MasterSetupTitle}"
        Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="560">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static text:AppText.MasterSetupIntro}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,12" />

        <Border Background="#FFF4E5"
                BorderBrush="#E0A040"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,16">
            <TextBlock Text="{x:Static text:AppText.MasterSetupWarning}"
                       TextWrapping="Wrap"
                       Foreground="#7A4A00"
                       FontWeight="SemiBold" />
        </Border>

        <TextBlock Text="{x:Static text:AppText.MasterSetupNewPasswordLabel}"
                   Margin="0,0,0,4" />
        <controls:RevealablePasswordBox x:Name="NewPasswordInput"
                                        Margin="0,0,0,12" />

        <TextBlock Text="{x:Static text:AppText.MasterSetupConfirmPasswordLabel}"
                   Margin="0,0,0,4" />
        <controls:RevealablePasswordBox x:Name="ConfirmPasswordInput"
                                        Margin="0,0,0,12" />

        <TextBlock Text="{x:Static text:AppText.MasterHintLabel}"
                   Margin="0,0,0,4" />
        <TextBox x:Name="HintInput"
                 MinHeight="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,4" />
        <TextBlock Text="{x:Static text:AppText.MasterHintCaution}"
                   TextWrapping="Wrap"
                   Foreground="#666"
                   FontSize="12"
                   Margin="0,0,0,14" />

        <CheckBox x:Name="AckCheckbox"
                  Content="{x:Static text:AppText.MasterSetupAckCheckbox}"
                  Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CompleteButton"
                    Content="{x:Static text:AppText.MasterSetupCompleteButton}"
                    MinWidth="110"
                    MinHeight="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Complete_Click" />
            <Button x:Name="LaterButton"
                    Content="{x:Static text:AppText.MasterSetupLaterButton}"
                    MinWidth="110"
                    MinHeight="34"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
