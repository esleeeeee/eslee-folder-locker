<controls:ThemedWindow x:Class="FolderGate.App.MasterPasswordSetupWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
                       xmlns:controls="clr-namespace:FolderGate.App.Controls"
                       Title="{x:Static text:AppText.MasterSetupTitle}"
                       Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
                       WindowStartupLocation="CenterScreen"
                       ResizeMode="NoResize"
                       SizeToContent="Height"
                       Width="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="&#xEA18;"
                           FontFamily="{x:Static controls:ThemeFonts.Icons}"
                           FontSize="20"
                           Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock Text="{x:Static text:AppText.MasterSetupTitle}"
                           Style="{DynamicResource SubtitleText}"
                           FontSize="18"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{x:Static text:AppText.MasterSetupIntro}"
                       Style="{DynamicResource SecondaryText}"
                       Margin="0,0,0,14" />

            <Border Style="{DynamicResource InfoBarCaution}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{x:Static controls:ThemeFonts.Icons}"
                               Foreground="{DynamicResource CautionForegroundBrush}"
                               VerticalAlignment="Top"
                               Margin="0,2,10,0" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Static text:AppText.MasterSetupWarning}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>

            <TextBlock Text="{x:Static text:AppText.MasterSetupNewPasswordLabel}" Style="{DynamicResource FieldLabel}" />
            <controls:RevealablePasswordBox x:Name="NewPasswordInput" Margin="0,0,0,14" />

            <TextBlock Text="{x:Static text:AppText.MasterSetupConfirmPasswordLabel}" Style="{DynamicResource FieldLabel}" />
            <controls:RevealablePasswordBox x:Name="ConfirmPasswordInput" Margin="0,0,0,14" />

            <TextBlock Text="{x:Static text:AppText.MasterHintLabel}" Style="{DynamicResource FieldLabel}" />
            <TextBox x:Name="HintInput"
                     MinHeight="34"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,6" />
            <TextBlock Text="{x:Static text:AppText.MasterHintCaution}"
                       Style="{DynamicResource CaptionText}"
                       Margin="0,0,0,16" />

            <CheckBox x:Name="AckCheckbox">
                <TextBlock Text="{x:Static text:AppText.MasterSetupAckCheckbox}" TextWrapping="Wrap" />
            </CheckBox>

            <Border x:Name="ErrorPanel"
                    Style="{DynamicResource InfoBarCritical}"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA39;"
                               FontFamily="{x:Static controls:ThemeFonts.Icons}"
                               Foreground="{DynamicResource CriticalForegroundBrush}"
                               VerticalAlignment="Top"
                               Margin="0,2,10,0" />
                    <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CompleteButton"
                        Style="{DynamicResource AccentButton}"
                        Content="{x:Static text:AppText.MasterSetupCompleteButton}"
                        MinWidth="110"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="Complete_Click" />
                <Button x:Name="LaterButton"
                        Content="{x:Static text:AppText.MasterSetupLaterButton}"
                        MinWidth="110"
                        MinHeight="34"
                        IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
