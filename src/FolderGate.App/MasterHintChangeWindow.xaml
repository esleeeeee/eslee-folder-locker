<controls:ThemedWindow x:Class="FolderGate.App.MasterHintChangeWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
                       xmlns:controls="clr-namespace:FolderGate.App.Controls"
                       Title="{x:Static text:AppText.MasterHintChangeTitle}"
                       Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
                       WindowStartupLocation="CenterOwner"
                       ResizeMode="NoResize"
                       SizeToContent="Height"
                       ShowInTaskbar="False"
                       Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="&#xEA18;"
                           FontFamily="{x:Static controls:ThemeFonts.Icons}"
                           FontSize="20"
                           Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock Text="{x:Static text:AppText.MasterHintChangeTitle}"
                           Style="{DynamicResource SubtitleText}"
                           FontSize="18"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{x:Static text:AppText.MasterChangeCurrentLabel}" Style="{DynamicResource FieldLabel}" />
            <controls:RevealablePasswordBox x:Name="CurrentPasswordInput" Margin="0,0,0,14" />

            <TextBlock Text="{x:Static text:AppText.MasterHintLabel}" Style="{DynamicResource FieldLabel}" />
            <TextBox x:Name="HintInput"
                     MinHeight="34"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,6" />
            <TextBlock Text="{x:Static text:AppText.MasterHintCaution}" Style="{DynamicResource CaptionText}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource AccentButton}"
                        Content="{x:Static text:AppText.MasterChangeButton}"
                        MinWidth="96"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="Change_Click" />
                <Button Content="{x:Static text:AppText.Cancel}"
                        MinWidth="96"
                        MinHeight="34"
                        IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
