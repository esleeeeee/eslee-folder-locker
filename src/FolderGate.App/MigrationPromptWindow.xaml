<Window x:Class="FolderGate.App.MigrationPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
        Title="{x:Static text:AppText.MigrationPromptTitle}"
        Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="600">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static text:AppText.MigrationPromptIntro}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,12" />

        <ListBox x:Name="CandidateList"
                 MinHeight="80"
                 MaxHeight="180"
                 Margin="0,0,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock Text="{Binding RootPath}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SourceKind}"
                                   Foreground="#666"
                                   FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{x:Static text:AppText.MigrationRunButton}"
                    MinWidth="100"
                    MinHeight="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Migrate_Click" />
            <Button Content="{x:Static text:AppText.MigrationChooseFolderButton}"
                    MinWidth="120"
                    MinHeight="34"
                    Margin="0,0,8,0"
                    Click="ChooseFolder_Click" />
            <Button Content="{x:Static text:AppText.MigrationSkipButton}"
                    MinWidth="100"
                    MinHeight="34"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
