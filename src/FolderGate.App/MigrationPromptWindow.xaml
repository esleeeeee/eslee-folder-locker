<controls:ThemedWindow x:Class="FolderGate.App.MigrationPromptWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
                       xmlns:controls="clr-namespace:FolderGate.App.Controls"
                       Title="{x:Static text:AppText.MigrationPromptTitle}"
                       Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
                       WindowStartupLocation="CenterScreen"
                       ResizeMode="NoResize"
                       SizeToContent="Height"
                       Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="&#xE8B7;"
                           FontFamily="{x:Static controls:ThemeFonts.Icons}"
                           FontSize="20"
                           Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock Text="{x:Static text:AppText.MigrationPromptTitle}"
                           Style="{DynamicResource SubtitleText}"
                           FontSize="18"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{x:Static text:AppText.MigrationPromptIntro}"
                       Style="{DynamicResource SecondaryText}"
                       Margin="0,0,0,14" />

            <ListBox x:Name="CandidateList"
                     MinHeight="80"
                     MaxHeight="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding RootPath}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SourceKind}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource AccentButton}"
                        Content="{x:Static text:AppText.MigrationRunButton}"
                        MinWidth="100"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="Migrate_Click" />
                <Button Content="{x:Static text:AppText.MigrationChooseFolderButton}"
                        MinWidth="120"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        Click="ChooseFolder_Click" />
                <Button Content="{x:Static text:AppText.MigrationSkipButton}"
                        MinWidth="100"
                        MinHeight="34"
                        IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
