<Window x:Class="FolderGate.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
        Title="{x:Static text:AppText.SettingsTitle}"
        Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static text:AppText.SettingsCloseBehaviorLabel}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <RadioButton x:Name="CloseToTrayOption"
                     Content="{x:Static text:AppText.SettingsCloseToTrayOption}"
                     GroupName="CloseBehavior"
                     Margin="0,0,0,6" />
        <RadioButton x:Name="ExitOnCloseOption"
                     Content="{x:Static text:AppText.SettingsExitOnCloseOption}"
                     GroupName="CloseBehavior"
                     Margin="0,0,0,16" />

        <CheckBox x:Name="AutoStartOption"
                  Content="{x:Static text:AppText.SettingsAutoStartLabel}"
                  Margin="0,0,0,16" />

        <Separator Margin="0,0,0,12" />

        <TextBlock Text="{x:Static text:AppText.UpdateSectionLabel}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <TextBlock x:Name="VersionText"
                   Margin="0,0,0,4" />
        <TextBlock x:Name="UpdateStatusText"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,20">
            <Button x:Name="CheckUpdateButton"
                    Content="{x:Static text:AppText.CheckForUpdatesButton}"
                    MinWidth="120"
                    MinHeight="30"
                    Margin="0,0,8,0"
                    Click="CheckUpdate_Click" />
            <Button Content="{x:Static text:AppText.OpenReleasePageButton}"
                    MinWidth="140"
                    MinHeight="30"
                    Click="OpenReleasePage_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{x:Static text:AppText.SettingsSaveButton}"
                    MinWidth="96"
                    MinHeight="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Save_Click" />
            <Button Content="{x:Static text:AppText.Cancel}"
                    MinWidth="96"
                    MinHeight="34"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
