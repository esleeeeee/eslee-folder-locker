<Window x:Class="FolderGate.App.MasterPasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
        xmlns:controls="clr-namespace:FolderGate.App.Controls"
        Title="{x:Static text:AppText.MasterChangeTitle}"
        Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static text:AppText.MasterChangeCurrentLabel}"
                   Margin="0,0,0,4" />
        <controls:RevealablePasswordBox x:Name="CurrentPasswordInput"
                                        Margin="0,0,0,12" />

        <TextBlock Text="{x:Static text:AppText.MasterSetupNewPasswordLabel}"
                   Margin="0,0,0,4" />
        <controls:RevealablePasswordBox x:Name="NewPasswordInput"
                                        Margin="0,0,0,12" />

        <TextBlock Text="{x:Static text:AppText.MasterSetupConfirmPasswordLabel}"
                   Margin="0,0,0,4" />
        <controls:RevealablePasswordBox x:Name="ConfirmPasswordInput"
                                        Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{x:Static text:AppText.MasterChangeButton}"
                    MinWidth="96"
                    MinHeight="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Change_Click" />
            <Button Content="{x:Static text:AppText.Cancel}"
                    MinWidth="96"
                    MinHeight="34"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
