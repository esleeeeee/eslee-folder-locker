<controls:ThemedWindow x:Class="FolderGate.App.PasswordDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
                       xmlns:controls="clr-namespace:FolderGate.App.Controls"
                       WindowStartupLocation="Manual"
                       ResizeMode="NoResize"
                       SizeToContent="Height"
                       Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
                       Width="460"
                       MinWidth="460"
                       MinHeight="360"
                       Loaded="PasswordDialog_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="HeaderGlyph"
                           Text="&#xE8D7;"
                           FontFamily="{x:Static controls:ThemeFonts.Icons}"
                           FontSize="20"
                           Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="HeaderText"
                           Style="{DynamicResource SubtitleText}"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       Style="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,0,0,16" />

            <TextBlock Text="{x:Static text:AppText.Password}" Style="{DynamicResource FieldLabel}" />
            <PasswordBox x:Name="PasswordInput"
                         MinHeight="34"
                         VerticalContentAlignment="Center" />

            <StackPanel x:Name="ConfirmPanel" Margin="0,14,0,0">
                <TextBlock Text="{x:Static text:AppText.PasswordConfirmation}" Style="{DynamicResource FieldLabel}" />
                <PasswordBox x:Name="ConfirmInput"
                             MinHeight="34"
                             VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="UnlockDurationPanel" Margin="0,14,0,0">
                <TextBlock Text="{x:Static text:AppText.UnlockDuration}" Style="{DynamicResource FieldLabel}" />
                <ComboBox x:Name="UnlockDurationInput"
                          MinHeight="34"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="Label" />
            </StackPanel>

            <Border x:Name="ErrorPanel"
                    Style="{DynamicResource InfoBarCritical}"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA39;"
                               FontFamily="{x:Static controls:ThemeFonts.Icons}"
                               Foreground="{DynamicResource CriticalForegroundBrush}"
                               VerticalAlignment="Top"
                               Margin="0,2,10,0" />
                    <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Style="{DynamicResource AccentButton}"
                        Content="{x:Static text:AppText.Ok}"
                        MinWidth="96"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="Ok_Click" />
                <Button x:Name="CancelButton"
                        Content="{x:Static text:AppText.Cancel}"
                        MinWidth="96"
                        MinHeight="34"
                        IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</controls:ThemedWindow>
