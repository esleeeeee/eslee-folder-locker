<controls:ThemedWindow x:Class="FolderGate.App.LogWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:text="clr-namespace:FolderGate.Core.Localization;assembly=FolderGate.Core"
                       xmlns:controls="clr-namespace:FolderGate.App.Controls"
                       Title="{x:Static text:AppText.LogWindowTitle}"
                       Icon="pack://application:,,,/FolderGate.App;component/assets/icons/eslee-folder-locker.ico"
                       WindowStartupLocation="CenterOwner"
                       ShowInTaskbar="False"
                       Width="860"
                       Height="560"
                       MinWidth="520"
                       MinHeight="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="24,18,24,12">
            <TextBlock Text="&#xE81C;"
                       FontFamily="{x:Static controls:ThemeFonts.Icons}"
                       FontSize="20"
                       Foreground="{DynamicResource AccentTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <TextBlock Text="{x:Static text:AppText.LogWindowTitle}"
                       Style="{DynamicResource SubtitleText}"
                       FontSize="18"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBox x:Name="LogText"
                 Grid.Row="1"
                 Margin="24,0,24,16"
                 Padding="12,10"
                 FontFamily="{x:Static controls:ThemeFonts.Mono}"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto">
            <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False" />
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>

        <Border Grid.Row="2" Style="{DynamicResource DialogFooter}">
            <Button Content="{x:Static text:AppText.Close}"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    MinHeight="34"
                    IsCancel="True"
                    IsDefault="True" />
        </Border>
    </Grid>
</controls:ThemedWindow>
